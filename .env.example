# PostgreSQL incident persistence. Leave unset only when intentionally running
# without the incident database; database-backed incident endpoints will return
# a clear 503 response in that case.
DATABASE_URL=postgresql://USERNAME:PASSWORD@localhost:5432/autoops

# Optional comma-separated browser origins for the FastAPI CORS policy.
# CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
